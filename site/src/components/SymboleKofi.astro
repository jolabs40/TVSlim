---
// Ko-fi symbol, the file from Ko-fi's brand assets, untinted and unmodified (NOTICE-LOGOS.md).
// The cup is 96 x 77, wider than tall.
interface Props {
  /** Displayed width in pixels. */
  taille?: number;
}
const { taille = 24 } = Astro.props;
---
<img src="/logos/kofi-symbol.png" width={taille} height={Math.round((taille * 77) / 96)} alt="" decoding="async" />
