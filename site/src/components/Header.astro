---
import Logo from './Logo.astro';
import { path, ui, REPO, type Lang } from '../site';

interface Props {
  lang: Lang;
  /** Chemin de la page sans préfixe de langue, pour la bascule. */
  page: string;
  current?: 'home' | 'download' | 'guide' | 'packages' | 'privacy';
}
const { lang, page, current } = Astro.props;
const t = ui[lang];
const autre: Lang = lang === 'en' ? 'fr' : 'en';
const liens = [
  { id: 'download', href: path(lang, '/download/'), label: t.nav.download },
  { id: 'guide', href: path(lang, '/guide/'), label: t.nav.guide },
  { id: 'packages', href: path(lang, '/packages/'), label: t.nav.packages },
] as const;
---
<header class="top">
  <div class="wrap bar">
    <a class="brand" href={path(lang, '/')} aria-label="TV Slim">
      <Logo size={34} />
      <span class="word"><span class="tv">TV</span> Slim</span>
    </a>
    <nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      {liens.map((l) => (
        <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href={REPO} rel="noopener">{t.nav.github}</a>
      <a class="lang" href={path(autre, page)} hreflang={autre} lang={autre}>{t.switchTo}</a>
    </nav>
  </div>
</header>

<style>
  .top { border-bottom: 1px solid var(--line); background: rgb(12 16 19 / 0.92); position: sticky; top: 0; z-index: 5; backdrop-filter: blur(8px); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; min-height: 64px; flex-wrap: wrap; padding-block: 8px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .word { font: 600 22px/1 var(--display); letter-spacing: -0.01em; }
  .tv { color: var(--blue); }
  nav { display: flex; flex-wrap: wrap; gap: 4px 18px; align-items: center; }
  nav a { color: var(--muted); text-decoration: none; font-size: 15.5px; padding-block: 6px; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  nav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--mint); }
  .lang { border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px !important; }
</style>
