---
import { ui, type Lang } from '../site';
import type { RiskLevel } from '../data/catalogue';

interface Props {
  lang: Lang;
  level?: RiskLevel;
  isProtected?: boolean;
  untested?: boolean;
}
const { lang, level, isProtected = false, untested = false } = Astro.props;
const t = ui[lang];
---
{isProtected ? <span class="badge r-protege">{t.protected}</span> : level && <span class={`badge r-${level}`}>{t.risk[level]}</span>}
{untested && <span class="badge r-nonteste">{t.untested}</span>}
