---
import Base from '../layouts/Base.astro';
import Risk from '../components/Risk.astro';
import { catalogue, brandName, BRAND_ORDER } from '../data/catalogue';
import { path, ISSUE_DEVICE, type Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fr = lang === 'fr';
const cat = catalogue(lang);
const byBrand = BRAND_ORDER.map((b) => ({
  brand: b,
  entries: cat.entries.filter((e) => e.brand === b).sort((x, y) => x.name.localeCompare(y.name, lang)),
})).filter((g) => g.entries.length > 0);
const protectedPackages = [...cat.protectedPackages].sort(
  (a, b) => BRAND_ORDER.indexOf(a.brand) - BRAND_ORDER.indexOf(b.brand) || a.packageName.localeCompare(b.packageName),
);

const t = fr
  ? {
      title: 'Paquets Android TV et Google TV : à quoi ils servent, peut-on les désactiver ? | TV Slim',
      description: `${cat.entries.length} paquets d’Android TV, de Google TV, de TCL, Philips, Sony, NVIDIA et Xiaomi décrits, avec leur niveau de risque et leurs effets de bord, et ${cat.protectedPackages.length} paquets à ne jamais désactiver.`,
      h1: 'Les paquets d’Android TV et de Google TV',
      lede: `Ce que fait chaque paquet, ce que coûte sa désactivation, et ceux auxquels il ne faut jamais toucher. ${cat.entries.length} paquets décrits, ${cat.protectedPackages.length} protégés : le catalogue même de TV Slim.`,
      legend: 'Le niveau de risque dit ce qu’on perd en désactivant le paquet. « Non éprouvé » : décrit d’après un inventaire ou des rapports, sans avoir été coupé sur un appareil — aucun profil de TV Slim ne le coche.',
      filter: 'Filtrer les paquets',
      filterPlaceholder: 'Nom ou paquet, par exemple « launcherx »',
      all: 'Toutes',
      noMatch: 'Aucun paquet ne correspond.',
      col: ['Application', 'Paquet', 'Catégorie', 'Risque'],
      protH2: 'Ne jamais les désactiver',
      protP: 'TV Slim refuse de désactiver ces paquets, quelle que soit la sélection : sans eux, le téléviseur peut redémarrer en boucle, perdre ses entrées HDMI ou ne plus obéir à la télécommande.',
      protCol: ['Paquet', 'Marque', 'Pourquoi'],
      missH2: 'Votre téléviseur n’y est pas ?',
      missP: 'Sur une marque que le catalogue ne connaît pas encore, TV Slim liste les paquets inconnus à part, sans rien proposer d’en faire. « Proposer au catalogue » exporte leur inventaire et ouvre un formulaire GitHub pour l’envoyer.',
      missLink: 'Ouvrir le formulaire',
    }
  : {
      title: 'Android TV & Google TV packages: what they do, can you disable them? | TV Slim',
      description: `${cat.entries.length} Android TV, Google TV, TCL, Philips, Sony, NVIDIA and Xiaomi packages described, with their risk level and side effects, and ${cat.protectedPackages.length} packages you must never disable.`,
      h1: 'Android TV and Google TV packages',
      lede: `What each package does, what disabling it costs, and the ones you must never touch. ${cat.entries.length} packages described, ${cat.protectedPackages.length} protected: TV Slim’s own catalogue.`,
      legend: 'The risk level says what you lose by disabling the package. “Not tested”: described from an inventory or from reports, without having been disabled on a device — no TV Slim profile selects it.',
      filter: 'Filter the packages',
      filterPlaceholder: 'Name or package, for instance “launcherx”',
      all: 'All',
      noMatch: 'No package matches.',
      col: ['App', 'Package', 'Category', 'Risk'],
      protH2: 'Never disable these',
      protP: 'TV Slim refuses to disable these packages, whatever the selection: without them, the TV may boot loop, lose its HDMI inputs or stop obeying the remote.',
      protCol: ['Package', 'Maker', 'Why'],
      missH2: 'Your TV is not here?',
      missP: 'On a make the catalogue does not know yet, TV Slim lists the unknown packages apart, with nothing offered to do about them. “Propose to the catalogue” exports their inventory and opens a GitHub form to send it.',
      missLink: 'Open the form',
    };
---
<Base lang={lang} page="/packages/" current="packages" title={t.title} description={t.description}>
  <section>
    <div class="wrap">
      <div class="head">
        <h1>{t.h1}</h1>
        <p class="lede">{t.lede}</p>
        <p class="muted legend">{t.legend}</p>
      </div>

      <div class="filters" role="search">
        <label class="search">
          <span class="visually-hidden">{t.filter}</span>
          <input id="filtre" type="search" placeholder={t.filterPlaceholder} autocomplete="off" />
        </label>
        <div class="chips" role="group" aria-label={t.filter}>
          <button type="button" data-marque="" aria-pressed="true">{t.all}</button>
          {byBrand.map((g) => <button type="button" data-marque={g.brand} aria-pressed="false">{brandName(g.brand, lang)}</button>)}
        </div>
      </div>
      <p id="vide" class="muted" hidden>{t.noMatch}</p>

      {byBrand.map((g) => (
        <div class="group" data-groupe={g.brand}>
          <h2 id={`marque-${g.brand.toLowerCase().replace(/\s+/g, '-')}`}>{brandName(g.brand, lang)} <span class="count">{g.entries.length}</span></h2>
          <div class="table-wrap">
            <table>
              <thead><tr>{t.col.map((c) => <th scope="col">{c}</th>)}</tr></thead>
              <tbody>
                {g.entries.map((e) => (
                  <tr data-texte={`${e.name} ${e.packageName}`.toLowerCase()}>
                    <td><a href={path(lang, `/packages/${e.packageName}/`)}>{e.name}</a></td>
                    <td class="pkg">{e.packageName}</td>
                    <td class="muted">{cat.categories.get(e.category)}</td>
                    <td class="badges"><Risk lang={lang} level={e.risk} untested={!e.tested} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="never-disable">
    <div class="wrap">
      <div class="head">
        <h2>{t.protH2}</h2>
        <p class="lede">{t.protP}</p>
      </div>
      <div class="table-wrap group" data-groupe="*">
        <table>
          <thead><tr>{t.protCol.map((c) => <th scope="col">{c}</th>)}</tr></thead>
          <tbody>
            {protectedPackages.map((p) => (
              <tr data-texte={`${p.reason} ${p.packageName}`.toLowerCase()} data-marque={p.brand}>
                <td><a class="pkg link" href={path(lang, `/packages/${p.packageName}/`)}>{p.packageName}</a></td>
                <td>{brandName(p.brand, lang)}</td>
                <td class="muted">{p.reason}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap stack" style="max-width:760px">
      <h2>{t.missH2}</h2>
      <p>{t.missP}</p>
      <p><a href={ISSUE_DEVICE} rel="noopener">{t.missLink} →</a></p>
    </div>
  </section>
</Base>

<script>
  // Client-side filter by text (name or package) and brand. Without JavaScript everything stays visible.
  const searchInput = document.getElementById('filtre') as HTMLInputElement | null;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chips button')];
  const emptyMessage = document.getElementById('vide');
  let brand = '';
  function applyFilter() {
    const q = (searchInput?.value ?? '').trim().toLowerCase();
    let visibleCount = 0;
    document.querySelectorAll<HTMLElement>('[data-groupe]').forEach((group) => {
      const spansAllBrands = group.dataset.groupe === '*';
      let shownInGroup = 0;
      group.querySelectorAll<HTMLTableRowElement>('tbody tr').forEach((row) => {
        const b = spansAllBrands ? row.dataset.marque : group.dataset.groupe;
        const ok = (!q || (row.dataset.texte ?? '').includes(q)) && (!brand || b === brand);
        row.hidden = !ok;
        if (ok) shownInGroup++;
      });
      group.hidden = shownInGroup === 0;
      if (!spansAllBrands) visibleCount += shownInGroup;
    });
    if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
  }
  searchInput?.addEventListener('input', applyFilter);
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      brand = chip.dataset.marque ?? '';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      applyFilter();
    }),
  );
</script>

<style>
  .legend { font-size: 15px; }
  .filters { display: grid; gap: 14px; margin-bottom: 28px; position: sticky; top: 64px; z-index: 2; background: var(--bg); padding-block: 12px; }
  .search input { width: 100%; max-width: 520px; font: 16px var(--body); color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
  .search input:focus { border-color: var(--blue); outline: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips button { font: 500 14px var(--body); color: var(--muted); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; cursor: pointer; }
  .chips button[aria-pressed='true'] { background: var(--mint); color: var(--mint-ink); border-color: var(--mint); }
  .group { margin-bottom: 36px; }
  .group h2 { font-size: 24px; margin-bottom: 14px; display: flex; align-items: baseline; gap: 10px; }
  .count { font: 500 14px var(--mono); color: var(--muted); }
  td a { color: var(--ink); text-decoration: none; font-weight: 500; }
  td a:hover { color: var(--blue); text-decoration: underline; }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .link { color: var(--ink) !important; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 640px) { th:nth-child(3), td:nth-child(3) { display: none; } }
</style>
