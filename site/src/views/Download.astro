---
import Base from '../layouts/Base.astro';
import { publications, fichier, mo } from '../data/releases';
import { path, RELEASES, ANDROID_RELEASES, CERT_SHA256, REPO, type Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fr = lang === 'fr';
const { windows, android } = await publications();
const msi = fichier(windows, (n) => n.endsWith('.msi'));
const portable = fichier(windows, (n) => n.endsWith('-portable.zip'));
const sommesWin = fichier(windows, (n) => n === 'SHA256SUMS.txt');
const remote = fichier(android, (n) => n.startsWith('TVSlim-Remote-') && n.endsWith('.apk'));
const tv = fichier(android, (n) => n.startsWith('TVSlim-TV-') && n.endsWith('.apk'));
const sommesAnd = fichier(android, (n) => n === 'SHA256SUMS.txt');
const date = (d?: string) => (d ? new Date(d).toLocaleDateString(fr ? 'fr-FR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '');

const t = fr
  ? {
      title: 'Télécharger TV Slim pour Windows et Android',
      description: 'TV Slim pour Windows (installateur MSI ou version portable) et pour Android (TV Slim Remote, et l’application facultative du téléviseur). Gratuit, libre, publié sur GitHub.',
      h1: 'Télécharger TV Slim',
      lede: 'Deux façons de piloter le téléviseur : depuis un PC Windows, ou depuis un téléphone Android. Les deux font le même débloat, avec le même catalogue et les mêmes garde-fous.',
      version: 'Version',
      du: 'du',
      winH2: 'Pour Windows',
      winReq: 'Windows 10 ou 11, 64 bits. Java est inclus : il n’y a rien d’autre à installer.',
      msiT: 'Installateur (recommandé)',
      msiD: 'Installe TV Slim pour votre compte — sans droits d’administrateur — et le tient à jour.',
      zipT: 'Version portable',
      zipD: 'S’utilise sans installation : décompressez, puis ouvrez TV Slim.exe.',
      smartT: '« Windows a protégé votre ordinateur » ?',
      smartP: 'TV Slim est un logiciel libre et gratuit, dont l’installateur n’est pas signé par un certificat payant : SmartScreen peut vous avertir la première fois. Cliquez sur Informations complémentaires, puis sur Exécuter quand même. SHA256SUMS.txt, publié à côté, permet de vérifier que le fichier est authentique.',
      majP: 'Au démarrage, TV Slim demande à GitHub s’il existe une nouvelle version — désactivable dans À propos. Rien ne se télécharge avant un clic sur Installer, et chaque installateur est signé par une clé Ed25519 que TV Slim vérifie avant de l’exécuter.',
      andH2: 'Pour Android',
      andReq: 'Android 8 ou plus récent. TV Slim pour Android est publié sur GitHub, pas sur le Play Store.',
      remoteT: 'TV Slim Remote, l’application du téléphone',
      remoteD: 'Ouvrez le fichier sur le téléphone, et autorisez votre navigateur ou votre gestionnaire de fichiers à installer des applications quand Android le demande.',
      tvT: 'L’application du téléviseur (facultative)',
      tvD: 'Elle affiche un QR code que le téléphone scanne pour se connecter, et garde le téléviseur joignable sur le réseau pendant la veille. Installez-la depuis TV Slim lui-même, avec Installer une application.',
      certP: 'Les deux APK sont signés par la même clé, dont le certificat a pour SHA-256 :',
      certNote: 'apksigner verify --print-certs l’affiche ; SHA256SUMS.txt liste les fichiers.',
      sums: 'Empreintes SHA-256',
      all: 'Toutes les versions',
      next: 'Ensuite : préparer le téléviseur',
      fallback: 'Voir la page des publications',
    }
  : {
      title: 'Download TV Slim for Windows and Android',
      description: 'TV Slim for Windows (MSI installer or portable) and for Android (TV Slim Remote, and the optional TV app). Free, open source, published on GitHub.',
      h1: 'Download TV Slim',
      lede: 'Two ways to drive the television: from a Windows PC, or from an Android phone. Both do the same debloat, with the same catalogue and the same safeguards.',
      version: 'Version',
      du: 'of',
      winH2: 'For Windows',
      winReq: 'Windows 10 or 11, 64-bit. Java is bundled: there is nothing else to install.',
      msiT: 'Installer (recommended)',
      msiD: 'Installs TV Slim for your user account — no administrator rights — and keeps it up to date.',
      zipT: 'Portable version',
      zipD: 'Runs without installing: unzip, then open TV Slim.exe.',
      smartT: '“Windows protected your PC”?',
      smartP: 'TV Slim is free, open-source software, and its installer is not signed with a paid certificate, so SmartScreen may warn you the first time. Click More info, then Run anyway. SHA256SUMS.txt, published alongside, lets you check the file is genuine.',
      majP: 'TV Slim asks GitHub for a new version when it starts — this can be switched off in About. Nothing is downloaded until you click Install, and every installer is signed with an Ed25519 key that TV Slim checks before running it.',
      andH2: 'For Android',
      andReq: 'Android 8 or later. TV Slim for Android is published on GitHub, not on the Play Store.',
      remoteT: 'TV Slim Remote, the phone app',
      remoteD: 'Open the file on the phone, and allow your browser or file manager to install apps when Android asks.',
      tvT: 'The TV app (optional)',
      tvD: 'It shows a QR code the phone scans to connect, and keeps the TV reachable on the network during standby. Install it from TV Slim itself, with Install an application.',
      certP: 'Both APKs are signed with the same key, whose certificate SHA-256 is:',
      certNote: 'apksigner verify --print-certs shows it; SHA256SUMS.txt lists the files.',
      sums: 'SHA-256 checksums',
      all: 'All releases',
      next: 'Next: prepare the television',
      fallback: 'See the releases page',
    };
---
<Base lang={lang} page="/download/" current="download" title={`${t.title} | TV Slim`} description={t.description}>
  <section>
    <div class="wrap">
      <div class="head">
        <h1>{t.h1}</h1>
        <p class="lede">{t.lede}</p>
      </div>

      <div class="dl">
        <article class="card stack" id="windows">
          <h2>{t.winH2}</h2>
          {windows && <p class="ver">{t.version} {windows.version} · {t.du} {date(windows.date)}</p>}
          <p class="muted">{t.winReq}</p>
          <ul class="files">
            <li>
              <a class="btn btn-primary" href={msi?.url ?? `${RELEASES}/latest`}>{t.msiT}</a>
              <p class="muted">{t.msiD}{msi && <span class="pkg"> {msi.nom} · {mo(msi.taille, lang)}</span>}</p>
            </li>
            <li>
              <a class="btn btn-ghost" href={portable?.url ?? `${RELEASES}/latest`}>{t.zipT}</a>
              <p class="muted">{t.zipD}{portable && <span class="pkg"> {portable.nom} · {mo(portable.taille, lang)}</span>}</p>
            </li>
          </ul>
          <div class="note">
            <p><strong>{t.smartT}</strong> {t.smartP}</p>
          </div>
          <p class="muted small">{t.majP}</p>
          <p class="links">
            {sommesWin && <a href={sommesWin.url}>{t.sums}</a>}
            <a href={windows?.url ?? `${RELEASES}/latest`}>{windows ? windows.tag : t.fallback}</a>
          </p>
        </article>

        <article class="card stack" id="android">
          <h2>{t.andH2}</h2>
          {android && <p class="ver">{t.version} {android.version} · {t.du} {date(android.date)}</p>}
          <p class="muted">{t.andReq}</p>
          <ul class="files">
            <li>
              <a class="btn btn-primary" href={remote?.url ?? ANDROID_RELEASES}>{t.remoteT}</a>
              <p class="muted">{t.remoteD}{remote && <span class="pkg"> {remote.nom} · {mo(remote.taille, lang)}</span>}</p>
            </li>
            <li>
              <a class="btn btn-ghost" href={tv?.url ?? ANDROID_RELEASES}>{t.tvT}</a>
              <p class="muted">{t.tvD}{tv && <span class="pkg"> {tv.nom} · {mo(tv.taille, lang)}</span>}</p>
            </li>
          </ul>
          <div class="note info">
            <p>{t.certP}</p>
            <p><code>{CERT_SHA256}</code></p>
            <p class="muted small">{t.certNote}</p>
          </div>
          <p class="links">
            {sommesAnd && <a href={sommesAnd.url}>{t.sums}</a>}
            <a href={android?.url ?? ANDROID_RELEASES}>{android ? android.tag : t.fallback}</a>
          </p>
        </article>
      </div>

      <p class="foot">
        <a href={RELEASES}>{t.all}</a> · <a href={REPO}>GitHub</a> · <a href={path(lang, '/guide/')}>{t.next} →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .dl { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); align-items: start; }
  .dl article { gap: 16px; padding: 26px; }
  .ver { font: 500 14px var(--mono); color: var(--mint); }
  .files { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .files li { display: grid; gap: 8px; justify-items: start; }
  .files .pkg { display: block; margin-top: 4px; font-size: 13px; }
  .small { font-size: 14.5px; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 15px; }
  .foot { margin-top: 28px; }
</style>
