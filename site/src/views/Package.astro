---
// Package page: what it does, what disabling it costs, and how TV Slim treats it.
// One page per package, to match searches like "what is com.tcl.xxx".
import Base from '../layouts/Base.astro';
import Risk from '../components/Risk.astro';
import DownloadButtons from '../components/DownloadButtons.astro';
import { catalogue, brandName } from '../data/catalogue';
import { path, url, SITE, STARTLIGHT, type Lang } from '../site';

interface Props {
  lang: Lang;
  id: string;
}
const { lang, id } = Astro.props;
const fr = lang === 'fr';
const cat = catalogue(lang);
const entry = cat.entries.find((e) => e.packageName === id);
const protectedPkg = cat.protectedPackages.find((p) => p.packageName === id);
const brand = entry?.brand ?? protectedPkg?.brand ?? '';
const name = entry?.name ?? protectedPkg?.reason ?? id;
const profile = entry ? cat.profileOf(entry) : undefined;
const isHomeScreen = entry?.category === 'accueil';
const related = [
  ...cat.entries.filter((e) => e.brand === brand && e.packageName !== id).map((e) => ({ id: e.packageName, name: e.name })),
  ...cat.protectedPackages.filter((p) => p.brand === brand && p.packageName !== id).map((p) => ({ id: p.packageName, name: p.packageName })),
].slice(0, 12);

const t = fr
  ? {
      title: protectedPkg
        ? `${id} : à ne jamais désactiver — ${brandName(brand, lang)} | TV Slim`
        : `${id} — ${name} : à quoi sert-il, peut-on le désactiver ? | TV Slim`,
      description: protectedPkg
        ? `${id} (${brandName(brand, lang)}) : ${protectedPkg.reason} Ne le désactivez pas — TV Slim le refuse, quelle que soit la sélection.`
        : `${id} (${brandName(brand, lang)}) : ${entry!.description}${entry!.sideEffect ? ` En le désactivant : ${entry!.sideEffect}` : ''}`,
      packages: 'Paquets',
      facts: ['Marque', 'Catégorie', 'Risque', 'Profil', 'Taille'],
      noProfile: 'Aucun profil : à désactiver un par un',
      sideEffect: 'En le désactivant :',
      untested: 'Non éprouvé : décrit d’après un inventaire ou des rapports, sans avoir été coupé sur un appareil. Aucun profil de TV Slim ne le coche ; il se désactive à la main, et se réactive depuis le journal.',
      tvslimH2: 'Ce que fait TV Slim',
      tvslimProtected: 'TV Slim refuse de désactiver ce paquet, quelle que soit la sélection. Ne le désactivez pas non plus à la main.',
      tvslimEntry: `TV Slim le désactive par pm disable-user --user 0 — il n’est jamais désinstallé — après une confirmation qui liste les effets de bord. Le journal garde la commande qui l’annule : un clic le réactive.`,
      homeScreen: 'TV Slim ne désactive l’écran d’accueil d’usine qu’une fois un autre launcher installé. Celui qu’il recommande, du même auteur :',
      homeScreenLink: 'Startlight Launcher, un accueil sans publicité',
      mainH2: 'À la main, en ADB',
      mainP: 'Les mêmes commandes, si vous préférez les taper. La première désactive le paquet pour l’utilisateur principal ; la seconde l’annule.',
      relatedH2: `Autres paquets ${brandName(brand, lang)}`,
      all: 'Tous les paquets',
      cta: 'Le désactiver sans taper de commande',
    }
  : {
      title: protectedPkg
        ? `${id}: never disable it — ${brandName(brand, lang)} | TV Slim`
        : `${id} — ${name}: what is it, can you disable it? | TV Slim`,
      description: protectedPkg
        ? `${id} (${brandName(brand, lang)}): ${protectedPkg.reason} Do not disable it — TV Slim refuses to, whatever the selection.`
        : `${id} (${brandName(brand, lang)}): ${entry!.description}${entry!.sideEffect ? ` If you disable it: ${entry!.sideEffect}` : ''}`,
      packages: 'Packages',
      facts: ['Maker', 'Category', 'Risk', 'Profile', 'Size'],
      noProfile: 'No profile: disable it on its own',
      sideEffect: 'If you disable it:',
      untested: 'Not tested: described from an inventory or from reports, without having been disabled on a device. No TV Slim profile selects it; it can be disabled by hand, and re-enabled from the log.',
      tvslimH2: 'What TV Slim does',
      tvslimProtected: 'TV Slim refuses to disable this package, whatever the selection. Do not disable it by hand either.',
      tvslimEntry: `TV Slim disables it with pm disable-user --user 0 — it is never uninstalled — after a confirmation that lists the side effects. The log keeps the command that undoes it: one click re-enables it.`,
      homeScreen: 'TV Slim only disables the factory home screen once another launcher is installed. The one it recommends, by the same author:',
      homeScreenLink: 'Startlight Launcher, an ad-free home screen',
      mainH2: 'By hand, over ADB',
      mainP: 'The same commands, if you would rather type them. The first one disables the package for the main user; the second one undoes it.',
      relatedH2: `Other ${brandName(brand, lang)} packages`,
      all: 'All packages',
      cta: 'Disable it without typing a command',
    };

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TV Slim', item: url(lang, '/') },
      { '@type': 'ListItem', position: 2, name: t.packages, item: url(lang, '/packages/') },
      { '@type': 'ListItem', position: 3, name: id, item: url(lang, `/packages/${id}/`) },
    ],
  },
  {
    '@type': 'WebPage',
    '@id': `${url(lang, `/packages/${id}/`)}#page`,
    name: t.title.replace(/ \| TV Slim$/, ''),
    description: t.description,
    inLanguage: lang,
    isPartOf: { '@id': `${SITE}/#site` },
    about: { '@type': 'SoftwareApplication', name: entry?.name ?? id, identifier: id, operatingSystem: 'Android TV, Google TV' },
  },
];
---
<Base lang={lang} page={`/packages/${id}/`} current="packages" title={t.title} description={t.description} schema={schema}>
  <section>
    <div class="wrap narrow stack" style="gap:26px">
      <nav class="crumbs" aria-label={fr ? 'Fil d’Ariane' : 'Breadcrumb'}>
        <a href={path(lang, '/packages/')}>{t.packages}</a> › <span>{brandName(brand, lang)}</span>
      </nav>
      <div class="stack" style="gap:12px">
        <h1>{protectedPkg ? id : name}</h1>
        {entry && <p class="pkg big">{id}</p>}
        <div class="badges">
          <Risk lang={lang} level={entry?.risk} isProtected={!!protectedPkg} untested={entry ? !entry.tested : false} />
        </div>
      </div>

      {protectedPkg && <div class="note danger"><p>{protectedPkg.reason}</p></div>}
      {entry && <p class="lede">{entry.description}</p>}
      {entry?.sideEffect && (
        <div class="note"><p><strong>{t.sideEffect}</strong> {entry.sideEffect}</p></div>
      )}
      {entry && !entry.tested && <div class="note info"><p>{t.untested}</p></div>}

      {entry && (
        <dl class="facts">
          <div><dt>{t.facts[0]}</dt><dd>{brandName(brand, lang)}</dd></div>
          <div><dt>{t.facts[1]}</dt><dd>{cat.categories.get(entry.category)}</dd></div>
          <div><dt>{t.facts[2]}</dt><dd>{(fr ? { aucun: 'aucun connu', faible: 'faible', moyen: 'moyen', eleve: 'élevé' } : { aucun: 'none known', faible: 'low', moyen: 'medium', eleve: 'high' })[entry.risk]}</dd></div>
          <div><dt>{t.facts[3]}</dt><dd>{profile ? profile.name : t.noProfile}</dd></div>
          {entry.sizeMb && <div><dt>{t.facts[4]}</dt><dd>{entry.sizeMb} {fr ? 'Mo' : 'MB'}</dd></div>}
        </dl>
      )}

      <div class="stack" style="gap:12px">
        <h2>{t.tvslimH2}</h2>
        <p>{protectedPkg ? t.tvslimProtected : t.tvslimEntry}</p>
        {isHomeScreen && (
          <p>{t.homeScreen} <a href={STARTLIGHT} rel="noopener">{t.homeScreenLink}</a>.</p>
        )}
      </div>

      {entry && (
        <div class="stack" style="gap:12px">
          <h2>{t.mainH2}</h2>
          <p class="muted">{t.mainP}</p>
          <pre><code>{`adb shell pm disable-user --user 0 ${id}\nadb shell pm enable ${id}`}</code></pre>
        </div>
      )}

      {!protectedPkg && (
        <div class="card stack cta">
          <h2>{t.cta}</h2>
          <DownloadButtons lang={lang} />
        </div>
      )}

      {related.length > 0 && (
        <div class="stack" style="gap:12px">
          <h2>{t.relatedH2}</h2>
          <ul class="voisins">
            {related.map((r) => <li><a href={path(lang, `/packages/${r.id}/`)}>{r.name}</a></li>)}
          </ul>
          <p><a href={path(lang, '/packages/')}>{t.all} →</a></p>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 860px; }
  .crumbs { font-size: 15px; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  h1 { font-size: clamp(30px, 4.6vw, 46px); overflow-wrap: anywhere; }
  .big { font-size: 17px; }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; }
  h2 { font-size: 24px; }
  .facts { margin: 0; display: grid; gap: 0; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); overflow: hidden; }
  .facts div { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 12px; padding: 11px 16px; border-bottom: 1px solid var(--line); }
  .facts div:last-child { border-bottom: 0; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .cta { gap: 16px; }
  .voisins { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .voisins a { display: inline-block; padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; color: var(--ink); background: var(--surface); font-size: 14.5px; }
  .voisins a:hover { border-color: var(--blue); }
</style>
