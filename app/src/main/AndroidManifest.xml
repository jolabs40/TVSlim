<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Application destinée aux téléviseurs : pilotage exclusif à la télécommande. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- Lecture de l'état des paquets du système, y compris désactivés. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Gardien de démarrage : réapplique les réglages que le téléviseur remet à zéro au boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Écriture des réglages système sans Shizuku. Non accordable depuis l'interface : elle doit
        l'être une fois par ADB, ce qui lui permet ensuite de survivre aux redémarrages.
        adb shell pm grant net.jolabs40.tvslim android.permission.WRITE_SECURE_SETTINGS
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Passerelle privilégiée (process en UID shell). -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
        Installation intégrée de Shizuku : téléchargement depuis le dépôt officiel, puis remise
        à l'installeur du système. L'APK est refusé si son certificat ne correspond pas à
        l'empreinte épinglée dans SourceShizuku, et c'est toujours le système qui demande
        confirmation avant d'installer.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".TvSlimApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_tvslim"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvSlim">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvSlim"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".system.DemarrageReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Verdict de PackageInstaller : intention explicite, jamais exposée. -->
        <receiver
            android:name=".install.InstallationReceiver"
            android:enabled="true"
            android:exported="false" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
