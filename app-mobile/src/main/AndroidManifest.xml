<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Seule permission nécessaire : ouvrir une socket TCP vers le téléviseur, sur le réseau
        local. Le compagnon ne demande ni stockage, ni localisation, ni comptes.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TvSlimRemoteApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_tvslim_remote"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvSlimRemote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TvSlimRemote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
