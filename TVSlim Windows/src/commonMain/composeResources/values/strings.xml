    <!-- About -->
    <string name="about_version">Version %1$s</string>
    <string name="about_description">Reversible debloat for Android TV, over ADB from this computer. Nothing is uninstalled or installed on the television unless you ask for it — an APK you send, a command you type. Every change is recorded in the log, with the command that undoes it whenever there is one.</string>
    <string name="about_open_source">Open source: anyone can read the code, rebuild the application and check what it does.</string>
