    <!-- Onglet Téléviseur -->
    <string name="connection_title">Se connecter à un téléviseur</string>
    <string name="connection_subtitle">Cet ordinateur parle au téléviseur en ADB, sur votre réseau local. Rien à installer sur le téléviseur.</string>
