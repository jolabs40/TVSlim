<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV app, driven by the remote only. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!--
        Read-only state of system packages, disabled ones included.

        Lint flags it, rightly in general. Here it only feeds `getInstalledApplications()` in
        AppareilRepository, i.e. the two counters on the home screen; the 96 catalogue entries, the
        current home and third-party launchers go through the <queries> below. Replacing it with 96
        <package> entries would cap those counters at what the catalogue already knows, and hide that
        a TV carries three times as many packages.

        The app is sideloaded, not on the Play Store, so Google's restriction does not apply.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Boot guardian: reapplies the settings the TV resets at boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Boot guardian: notifies when a system update undid the debloat. Requested when the guardian
         is enabled; if denied, the report stays on the app's home screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reads the local IP address to show it as a QR code for the companion. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Cannot be granted from the UI, only once over ADB; it then survives reboots, which the boot
        guardian depends on.
        adb shell pm grant net.jolabs40.tvslim android.permission.WRITE_SECURE_SETTINGS
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".TvSlimApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_tvslim"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvSlim">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvSlim"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".system.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!--
            Startup service StartLight launches at power-on: an invisible activity, the only entry point
            TCL's startup manager leaves open to a third-party app.
        -->
        <activity
            android:name=".system.TrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="net.jolabs40.startlight.action.SERVICE_DEMARRAGE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!--
            The phone or PC enables the guardian right after installing the app. Restricted to holders
            of WRITE_SECURE_SETTINGS: the ADB shell, and no app on the TV.
        -->
        <receiver
            android:name=".system.ActivationGardienReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="net.jolabs40.tvslim.action.ACTIVER_GARDIEN" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
