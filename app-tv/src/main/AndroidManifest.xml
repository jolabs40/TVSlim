<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Application destinée aux téléviseurs : pilotage exclusif à la télécommande. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!--
        Lecture de l'état des paquets du système, y compris désactivés. Lecture seule.

        Lint la refuse, et il a raison dans le cas général. Ici elle n'alimente qu'un seul
        appel — `getInstalledApplications()` dans AppareilRepository — donc les deux compteurs
        de l'écran d'accueil. Tout le reste (état des 96 entrées du catalogue, accueil courant,
        launchers tiers) passe par le <queries> déclaré plus bas.

        La remplacer par 96 <package> ferait tomber ces compteurs à 96 : ils ne diraient plus
        que ce que le catalogue connaît déjà, et la seule vue d'ensemble serait perdue — le
        fait qu'un téléviseur en porte trois fois plus.

        L'application ne va pas sur le Play Store (distribution en sideload, tranché le
        2026-09-11) : la restriction de Google ne s'y applique pas. Ne pas « corriger ».
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Gardien de démarrage : réapplique les réglages que le téléviseur remet à zéro au boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lecture de l'adresse IP locale, pour l'afficher en QR code à destination du compagnon. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Écriture des réglages système. Non accordable depuis l'interface : elle doit l'être une
        fois par ADB, ce qui lui permet ensuite de survivre aux redémarrages — condition sine
        qua non du gardien de démarrage.
        adb shell pm grant net.jolabs40.tvslim android.permission.WRITE_SECURE_SETTINGS
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".TvSlimApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_tvslim"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvSlim">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvSlim"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".system.DemarrageReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
